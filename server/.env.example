NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ronjuices
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Used in Part 2. Do not commit real credentials.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=http://localhost:4000/api/v1/payments/paynow/result
PAYNOW_RETURN_URL=http://localhost:3000/checkout/payment-return
# Comma-separated currencies enabled on the merchant profile. Keep USD only unless Paynow has enabled ZWG.
PAYNOW_ACCEPTED_CURRENCIES=USD

ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 product image storage. R2_PUBLIC_URL is a custom domain or r2.dev URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
